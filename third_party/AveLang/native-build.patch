     VERSION 0.1.0
     DESCRIPTION "Ave DSL Compiler"
-    LANGUAGES CXX
+    LANGUAGES C CXX
 )
 
 add_compile_options(-Wall -fvisibility=hidden -fPIC)
@@ -70,6 +73,18 @@ find_package(zstd CONFIG REQUIRED)
 find_package(LLVM 23.0 CONFIG REQUIRED)
 find_package(MLIR CONFIG REQUIRED)
 find_package(Clang REQUIRED CONFIG)
+if(NOT LLVM_ENABLE_RTTI)
+    add_compile_options(-fno-rtti)
+endif()
+
+# Match the installed LLVM shared/static linkage to avoid duplicate registries.
+function(ave_lang_link_llvm target)
+    if(LLVM_LINK_LLVM_DYLIB)
+        llvm_config(${target} USE_SHARED ${ARGN})
+    else()
+        llvm_config(${target} ${ARGN})
+    endif()
+endfunction()
 
 # Locate build tool executables using paths exported by LLVM/MLIR packages.
 if(NOT MLIR_OPT_EXECUTABLE)
