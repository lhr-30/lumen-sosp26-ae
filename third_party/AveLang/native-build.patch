 FetchContent_Declare(
     SetupHunter
     GIT_REPOSITORY https://github.com/cpp-pm/gate
     GIT_TAG v0.11.0
 )
 FetchContent_MakeAvailable(SetupHunter)
+endif()
 
 list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 
