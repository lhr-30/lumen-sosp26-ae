 find_package(pybind11 CONFIG REQUIRED)
 find_package(zstd CONFIG REQUIRED)
-find_package(LLVM CONFIG REQUIRED)
+find_package(LLVM 23.0 CONFIG REQUIRED)
 find_package(MLIR CONFIG REQUIRED)
 find_package(Clang REQUIRED CONFIG)
+if(NOT LLVM_ENABLE_RTTI)
+    add_compile_options(-fno-rtti)
+endif()
+
+# Match LLVM linkage to avoid duplicate registries from shared/static mixing.
+function(ave_lang_link_llvm target)
+    if(LLVM_LINK_LLVM_DYLIB)
+        llvm_config(${target} USE_SHARED ${ARGN})
+    else()
+        llvm_config(${target} ${ARGN})
+    endif()
+endfunction()
 find_program(Z3_EXECUTABLE NAMES z3 REQUIRED)
 set(Z3_EXECUTABLE "${Z3_EXECUTABLE}" CACHE FILEPATH "Path to Z3 executable")
 add_compile_definitions(AVELANG_Z3_EXECUTABLE="${Z3_EXECUTABLE}")
