+        alpha = S.nvvm.fast_exp2((maximum - new_max) * 1.4426950408889634)
+        probability = S.nvvm.fast_exp2((score - new_max) * 1.4426950408889634)
+        denominator = S.fma(denominator, alpha, probability)
+        for i in S.range(8, unroll=True):
