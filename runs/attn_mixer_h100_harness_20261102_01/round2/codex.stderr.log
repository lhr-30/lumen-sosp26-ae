    a_shared = S.make_shared((2, 16384), S.bf16, 128)

    a_tensor = S.make_tensor(
        a_ptr, S.bf16, S.make_layout((416, 32, 64), (2048, 64, 1))
    )
    b_tensor = S.make_tensor(
        w_ptr, S.bf16, S.make_layout((N, 32, 64), (2048, 64, 1))
    )
    out = S.make_tensor(
        o_ptr, S.bf16, S.make_layout((416, N), (N, 1))
    )
    out_words = S.view(out, S.i32, S.make_layout((416, N // 2), (N // 2, 1)))
    hidden = S.make_tensor(
        h_ptr, S.bf16, S.make_layout((416, 2048), (2048, 1))
    )
    a_map = S.nvvm.make_tma_descriptor(
        a_tensor, S.make_layout((128, 1, 64), (64, 8192, 1)),
        SWIZZLE_128B,
    )
    b_map = S.nvvm.make_tma_descriptor(
        b_tensor, S.make_layout((160, 1, 64), (64, 10240, 1)),
        SWIZZLE_128B,
    )

    for stage in S.range(2, unroll=True):
        S.nvvm.mbarrier_init(full, stage, count=1, predicate=tid == 0)
        S.nvvm.mbarrier_init(empty, stage, count=2, predicate=tid == 0)
    S.nvvm.fence_mbarrier_init_release_cluster()
    S.syncthreads()

    if tid < 256:
        accumulators = S.full((1, 80), 0.0, S.f32)
        phase = 0
        for kt in S.range(16):
            stage = kt % 2
            S.nvvm.mbarrier_try_wait_parity(full, phase, 10000000, stage)
            a_matrix = S.view(
                S.subview(a_shared, (stage, warpgroup * 4096), (1, 4096), (1, 1)),
                S.bf16, S.make_layout((64, 64), (64, 1)),
            )
            b_matrix = S.view(
                S.subview(b_shared, (stage, 0), (1, 10240), (1, 1)),
                S.bf16, S.make_layout((160, 64), (64, 1)),
            )
            da = S.nvvm.make_wgmma_descriptor_bits(
                a_matrix, SWIZZLE_128B, 0, 0, 0, 16, 1024
            )
            db = S.nvvm.make_wgmma_descriptor_bits(
                b_matrix, SWIZZLE_128B, 0, 0, 0, 16, 1024
            )
            acc = accumulators[0]
            S.nvvm.wgmma_fence_aligned()
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da, db, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 2, db + 2, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 4, db + 4, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 6, db + 6, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 1024, db + 1280, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 1026, db + 1282, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 1028, db + 1284, acc, 1)
            acc = S.nvvm.wgmma_m64n160k16_f32_bf16_bf16(da + 1030, db + 1286, acc, 1)
            S.nvvm.wgmma_group_sync_aligned()
            S.nvvm.wgmma_wait_group_sync(0)
            S.nvvm.wgmma_fence_aligned()
            for i in S.range(80, unroll=True):
                accumulators[0, i] = acc[i]
            if tid % 128 == 0:
                S.nvvm.mbarrier_arrive(empty, stage)
            if stage == 1:
                phase = phase ^ 1

        row0 = row_start + warpgroup * 64 + warp * 16 + lane // 4
        row1 = row0 + 8
        for group in S.range(20, unroll=True):
            col = col_start + group * 8 + (lane % 4) * 2
            v0 = S.convert(S.convert(accumulators[0, group * 4], S.bf16), S.f32)
            v1 = S.convert(S.convert(accumulators[0, group * 4 + 1], S.bf16), S.f32)
            v2 = S.convert(S.convert(accumulators[0, group * 4 + 2], S.bf16), S.f32)
            v3 = S.convert(S.convert(accumulators[0, group * 4 + 3], S.bf16), S.f32)
            if row0 < 416:
                if RESIDUAL == 1:
                    v0 = v0 + S.convert(hidden[row0, col], S.f32)
                    v1 = v1 + S.convert(hidden[row0, col + 1], S.f32)
                out_words[row0, col // 2] = S.nvvm.floatx2_to_bf16x2(v0, v1)
            if row1 < 416:
                if RESIDUAL == 1:
                    v2 = v2 + S.convert(hidden[row1, col], S.f32)
                    v3 = v3 + S.convert(hidden[row1, col + 1], S.f32)
                out_words[row1, col // 2] = S.nvvm.floatx2_to_bf16x2(v2, v3)
    else:
        elected = S.nvvm.elect_sync()
        phase = 1
        for kt in S.range(16):
            stage = kt % 2
            S.nvvm.mbarrier_try_wait_parity(empty, phase, 10000000, stage)
            S.nvvm.mbarrier_arrive_expect_tx(full, 73728, stage, elected)
            for part in S.range(2, unroll=True):
                a_dst = S.view(
                    S.subview(a_shared, (stage, part * 8192), (1, 8192), (1, 1)),
                    S.bf16, S.make_layout((128, 1, 64), (64, 8192, 1)),
                )
                b_dst = S.view(
                    S.subview(b_shared, (stage, part * 10240), (1, 10240), (1, 1)),
                    S.bf16, S.make_layout((160, 1, 64), (64, 10240, 1)),
                )
                S.nvvm.tma_load(
                    a_dst, a_map, (0, kt * 2 + part, row_start), full,
                    mbar_id=stage, predicate=elected, expect_tx=False,
                )
                S.nvvm.tma_load(
                    b_dst, b_map, (0, kt * 2 + part, col_start), full,
                    mbar_id=stage, predicate=elected, expect_tx=False,
                )
            if stage == 1:
                phase = phase ^ 1
    S.syncthreads()


@avelang.jit
def _linear(
    a_ptr: S.Pointer(S.bf16),
    w_ptr: S.Pointer(S.bf16),
    h_ptr: S.Pointer(S.bf16),
    o_ptr: S.Pointer(S.bf16),
    N: S.constexpr,
    RESIDUAL: S.constexpr,
):
    """64x64 WGMMA with two K128 stages and packed BF16 stores."""
    tid = S.thread_id(0)
    warp = tid // 32
    lane = tid % 32
    row_start = S.block_id(1) * 64
    col_start = S.block_id(0) * 64

    full = S.nvvm.mbarrier_create(2)
    empty = S.nvvm.mbarrier_create(2)
    b_shared = S.make_shared((2, 8192), S.bf16, 128)
    a_shared = S.make_shared((2, 8192), S.bf16, 128)

    a_tensor = S.make_tensor(
        a_ptr, S.bf16, S.make_layout((416, 32, 64), (2048, 64, 1))
    )
    b_tensor = S.make_tensor(
        w_ptr, S.bf16, S.make_layout((N, 32, 64), (2048, 64, 1))
    )
    out = S.make_tensor(
        o_ptr, S.bf16, S.make_layout((416, N), (N, 1))
    )
    out_words = S.view(out, S.i32, S.make_layout((416, N // 2), (N // 2, 1)))
    hidden = S.make_tensor(
        h_ptr, S.bf16, S.make_layout((416, 2048), (2048, 1))
    )
    a_map = S.nvvm.make_tma_descriptor(
        a_tensor, S.make_layout((64, 1, 64), (64, 4096, 1)),
        SWIZZLE_128B,
    )
    b_map = S.nvvm.make_tma_descriptor(
        b_tensor, S.make_layout((64, 1, 64), (64, 4096, 1)),
        SWIZZLE_128B,
    )

    for stage in S.range(2, unroll=True):
        S.nvvm.mbarrier_init(full, stage, count=1, predicate=tid == 0)
        S.nvvm.mbarrier_init(empty, stage, count=1, predicate=tid == 0)
    S.nvvm.fence_mbarrier_init_release_cluster()
    S.syncthreads()

    if tid < 128:
        accumulators = S.full((1, 32), 0.0, S.f32)
        phase = 0
        for kt in S.range(16):
            stage = kt % 2
            S.nvvm.mbarrier_try_wait_parity(full, phase, 10000000, stage)
            a_matrix = S.view(
                S.subview(a_shared, (stage, 0), (1, 4096), (1, 1)),
                S.bf16, S.make_layout((64, 64), (64, 1)),
            )
            b_matrix = S.view(
                S.subview(b_shared, (stage, 0), (1, 4096), (1, 1)),
                S.bf16, S.make_layout((64, 64), (64, 1)),
            )
            da = S.nvvm.make_wgmma_descriptor_bits(
                a_matrix, SWIZZLE_128B, 0, 0, 0, 16, 1024
            )
            db = S.nvvm.make_wgmma_descriptor_bits(
                b_matrix, SWIZZLE_128B, 0, 0, 0, 16, 1024
            )
            acc = accumulators[0]
            S.nvvm.wgmma_fence_aligned()
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da, db, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 2, db + 2, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 4, db + 4, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 6, db + 6, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 512, db + 512, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 514, db + 514, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 516, db + 516, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 518, db + 518, acc, 1)
            S.nvvm.wgmma_group_sync_aligned()
            S.nvvm.wgmma_wait_group_sync(0)
            S.nvvm.wgmma_fence_aligned()
            for i in S.range(32, unroll=True):
                accumulators[0, i] = acc[i]
            if tid == 0:
                S.nvvm.mbarrier_arrive(empty, stage)
            if stage == 1:
                phase = phase ^ 1

        row0 = row_start + warp * 16 + lane // 4
        row1 = row0 + 8
        for group in S.range(8, unroll=True):
            col = col_start + group * 8 + (lane % 4) * 2
            v0 = S.convert(S.convert(accumulators[0, group * 4], S.bf16), S.f32)
            v1 = S.convert(S.convert(accumulators[0, group * 4 + 1], S.bf16), S.f32)
            v2 = S.convert(S.convert(accumulators[0, group * 4 + 2], S.bf16), S.f32)
            v3 = S.convert(S.convert(accumulators[0, group * 4 + 3], S.bf16), S.f32)
            if row0 < 416:
                if RESIDUAL == 1:
                    v0 = v0 + S.convert(hidden[row0, col], S.f32)
                    v1 = v1 + S.convert(hidden[row0, col + 1], S.f32)
                out_words[row0, col // 2] = S.nvvm.floatx2_to_bf16x2(v0, v1)
            if row1 < 416:
                if RESIDUAL == 1:
                    v2 = v2 + S.convert(hidden[row1, col], S.f32)
                    v3 = v3 + S.convert(hidden[row1, col + 1], S.f32)
                out_words[row1, col // 2] = S.nvvm.floatx2_to_bf16x2(v2, v3)
    else:
        elected = S.nvvm.elect_sync()
        phase = 1
        for kt in S.range(16):
            stage = kt % 2
            S.nvvm.mbarrier_try_wait_parity(empty, phase, 10000000, stage)
            S.nvvm.mbarrier_arrive_expect_tx(full, 32768, stage, elected)
            for part in S.range(2, unroll=True):
                a_dst = S.view(
                    S.subview(a_shared, (stage, part * 4096), (1, 4096), (1, 1)),
                    S.bf16, S.make_layout((64, 1, 64), (64, 4096, 1)),
                )
                b_dst = S.view(
                    S.subview(b_shared, (stage, part * 4096), (1, 4096), (1, 1)),
                    S.bf16, S.make_layout((64, 1, 64), (64, 4096, 1)),
                )
                S.nvvm.tma_load(
                    a_dst, a_map, (0, kt * 2 + part, row_start), full,
                    mbar_id=stage, predicate=elected, expect_tx=False,
                )
                S.nvvm.tma_load(
                    b_dst, b_map, (0, kt * 2 + part, col_start), full,
                    mbar_id=stage, predicate=elected, expect_tx=False,
                )
            if stage == 1:
                phase = phase ^ 1
    S.syncthreads()


@avelang.jit
def _norm_rope(
    packed: S.Tensor((416, 5120), S.bf16),
    q_weight: S.Tensor((256,), S.bf16),
    k_weight: S.Tensor((256,), S.bf16),
    tables: S.Tensor((26, 32, 2), S.bf16),
    q: S.Tensor((416, 8, 256), S.bf16),
    k: S.Tensor((416, 2, 256), S.bf16),
):
    lane = S.thread_id(0) % 32
    work = S.block_id(0) * 4 + S.thread_id(0) // 32
    token = work // 10
    head = work % 10
    offset = head * 512
    if head >= 8:
        offset = 4096 + (head - 8) * 256

    values = S.make_local((8,), S.f32)
    squared = S.convert(0.0, S.f32)
    for i in S.range(8, unroll=True):
        v = S.convert(packed[token, offset + lane + i * 32], S.f32)
        values[i] = v
        squared = S.nvvm.fast_fma(v, v, squared)
    for shift in S.range(5, unroll=True):
        squared = squared + S.shuffle_xor(squared, 1 << shift, 32)
    scale = S.nvvm.fast_rsqrt(
        squared * S.convert(0.00390625, S.f32) + S.convert(0.000001, S.f32)
    )
    for i in S.range(8, unroll=True):
        d = lane + i * 32
        weight = S.convert(q_weight[d], S.f32)
        if head >= 8:
            weight = S.convert(k_weight[d], S.f32)
        values[i] = S.convert(
            S.convert(values[i] * scale * (S.convert(1.0, S.f32) + weight), S.bf16), S.f32
        )
    a = values[0]
    b = values[1]
    cos = S.convert(tables[token % 26, lane, 0], S.f32)
    sin = S.convert(tables[token % 26, lane, 1], S.f32)
    values[0] = a * cos - b * sin
    values[1] = b * cos + a * sin
    for i in S.range(8, unroll=True):
        d = lane + i * 32
        if head < 8:
            q[token, head, d] = S.convert(values[i], S.bf16)
        else:
            k[token, head - 8, d] = S.convert(values[i], S.bf16)


@avelang.jit
def _attention_gate(
    packed: S.Tensor((416, 5120), S.bf16),
    q: S.Tensor((416, 8, 256), S.bf16),
    k: S.Tensor((416, 2, 256), S.bf16),
    attended: S.Tensor((416, 8, 256), S.bf16),
):
    """One batch/head per CTA; BF16 QK and strictly FP32 softmax/PV."""
    tid = S.thread_id(0)
    warp = tid // 32
    lane = tid % 32
    head = S.block_id(0) % 8
    batch_start = (S.block_id(0) // 8) * 26
    kv_head = head // 4

    ready = S.nvvm.mbarrier_create()
    scores = S.make_shared((32, 32), S.f32, 128)
    v_shared = S.make_shared((4, 2048), S.bf16, 128)
    k_shared = S.make_shared((4, 4096), S.bf16, 128)
    q_shared = S.make_shared((4, 4096), S.bf16, 128)

    q_tensor = S.view(
        q, S.bf16, S.make_layout((416, 32, 64), (2048, 64, 1)),
    )
    k_tensor = S.view(
        k, S.bf16, S.make_layout((416, 8, 64), (512, 64, 1)),
    )
    v_tensor = S.view(
        packed, S.bf16, S.make_layout((416, 80, 64), (5120, 64, 1)),
    )
    q_map = S.nvvm.make_tma_descriptor(
        q_tensor, S.make_layout((64, 1, 64), (64, 4096, 1)),
        SWIZZLE_128B,
    )
    k_map = S.nvvm.make_tma_descriptor(
        k_tensor, S.make_layout((64, 1, 64), (64, 4096, 1)),
        SWIZZLE_128B,
    )
    v_map = S.nvvm.make_tma_descriptor(
        v_tensor, S.make_layout((32, 1, 64), (64, 2048, 1)), 0,
    )
    S.nvvm.mbarrier_init(ready, 0, count=1, predicate=tid == 0)
    S.nvvm.fence_mbarrier_init_release_cluster()
    S.syncthreads()
    S.nvvm.mbarrier_arrive_expect_tx(ready, 81920, 0, tid == 0)
    for chunk in S.range(4, unroll=True):
        q_dst = S.view(
            S.subview(q_shared, (chunk, 0), (1, 4096), (1, 1)),
            S.bf16, S.make_layout((64, 1, 64), (64, 4096, 1)),
        )
        k_dst = S.view(
            S.subview(k_shared, (chunk, 0), (1, 4096), (1, 1)),
            S.bf16, S.make_layout((64, 1, 64), (64, 4096, 1)),
        )
        v_dst = S.view(
            S.subview(v_shared, (chunk, 0), (1, 2048), (1, 1)),
            S.bf16, S.make_layout((32, 1, 64), (64, 2048, 1)),
        )
        S.nvvm.tma_load(
            q_dst, q_map, (0, head * 4 + chunk, batch_start), ready,
            predicate=tid == 0, expect_tx=False,
        )
        S.nvvm.tma_load(
            k_dst, k_map, (0, kv_head * 4 + chunk, batch_start), ready,
            predicate=tid == 0, expect_tx=False,
        )
        S.nvvm.tma_load(
            v_dst, v_map, (0, 72 + kv_head * 4 + chunk, batch_start), ready,
            predicate=tid == 0, expect_tx=False,
        )
    S.nvvm.mbarrier_try_wait_parity(ready, 0, 10000000, 0)

    if tid < 128:
        accumulators = S.full((1, 32), 0.0, S.f32)
        for chunk in S.range(4, unroll=True):
            acc = accumulators[0]
            S.nvvm.wgmma_fence_aligned()
            qm = S.view(
                S.subview(q_shared, (chunk, 0), (1, 4096), (1, 1)),
                S.bf16, S.make_layout((64, 64), (64, 1)),
            )
            km = S.view(
                S.subview(k_shared, (chunk, 0), (1, 4096), (1, 1)),
                S.bf16, S.make_layout((64, 64), (64, 1)),
            )
            da = S.nvvm.make_wgmma_descriptor_bits(
                qm, SWIZZLE_128B, 0, 0, 0, 16, 1024,
            )
            db = S.nvvm.make_wgmma_descriptor_bits(
                km, SWIZZLE_128B, 0, 0, 0, 16, 1024,
            )
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da, db, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 2, db + 2, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 4, db + 4, acc, 1)
            acc = S.nvvm.wgmma_m64n64k16_f32_bf16_bf16(da + 6, db + 6, acc, 1)
            S.nvvm.wgmma_group_sync_aligned()
            S.nvvm.wgmma_wait_group_sync(0)
            S.nvvm.wgmma_fence_aligned()
            for i in S.range(32, unroll=True):
                accumulators[0, i] = acc[i]
        row0 = warp * 16 + lane // 4
        row1 = row0 + 8
        for group in S.range(4, unroll=True):
            col = group * 8 + (lane % 4) * 2
            if row0 < 26:
                scores[row0, col] = accumulators[0, group * 4] * S.convert(0.0625, S.f32)
                scores[row0, col + 1] = accumulators[0, group * 4 + 1] * S.convert(0.0625, S.f32)
            if row1 < 26:
                scores[row1, col] = accumulators[0, group * 4 + 2] * S.convert(0.0625, S.f32)
                scores[row1, col + 1] = accumulators[0, group * 4 + 3] * S.convert(0.0625, S.f32)
    S.syncthreads()

    for position in S.range(warp, 26, 8):
        score = scores[position, lane]
        if lane > position:
            score = S.convert(-3.4028234663852886e38, S.f32)
        maximum = score
        for shift in S.range(5, unroll=True):
            maximum = S.nvvm.fast_fmax(maximum, S.shuffle_xor(maximum, 1 << shift, 32))
        probability = S.nvvm.fast_exp2((score - maximum) * S.convert(1.4426950408889634, S.f32))
        denominator = probability
        for shift in S.range(5, unroll=True):
            denominator = denominator + S.shuffle_xor(denominator, 1 << shift, 32)
        probability = probability * S.nvvm.fast_rcp(denominator)
        result = S.full((8,), 0.0, S.f32)
        for key_pos in S.range(26, unroll=True):
            p = S.shuffle(probability, key_pos, 32)
            for i in S.range(8, unroll=True):
                v = S.convert(v_shared[i // 2, key_pos * 64 + lane + (i % 2) * 32], S.f32)
                result[i] = S.nvvm.fast_fma(v, p, result[i])
        token = batch_start + position
        for i in S.range(8, unroll=True):
            d = lane + i * 32
            attention = S.convert(S.convert(result[i], S.bf16), S.f32)
            gate = S.convert(packed[token, head * 512 + 256 + d], S.f32)
            sigmoid = S.nvvm.fast_rcp(
                S.convert(1.0, S.f32) + S.nvvm.fast_exp2(-gate * S.convert(1.4426950408889634, S.f32))
            )
            sigmoid = S.convert(S.convert(sigmoid, S.bf16), S.f32)
            attended[token, head, d] = S.convert(attention * sigmoid, S.bf16)

OFFLINE_COMPILE_CASES = [
    ("qkv", _linear_wide, {"N": 5120, "RESIDUAL": 0}, 9),
    ("norm_rope", _norm_rope, {}, 4),
    ("attention_gate", _attention_gate, {}, 8),
    ("projection_residual", _linear, {"N": 2048, "RESIDUAL": 1}, 5),
]


def build(x, hidden, w, tables):
    packed = torch.empty((416, 5120), dtype=torch.bfloat16, device=x.device)
    q = torch.empty((416, 8, 256), dtype=torch.bfloat16, device=x.device)
    k = torch.empty((416, 2, 256), dtype=torch.bfloat16, device=x.device)
    attended = torch.empty((16, 26, 2048), dtype=torch.bfloat16, device=x.device)
    output = torch.empty_like(hidden)
    x_view = x.view(416, 2048)
    hidden_view = hidden.view(416, 2048)
    attended_view = attended.view(416, 8, 256)
    output_view = output.view(416, 2048)

    def qkv():
        _linear_wide[lambda: ((32, 4, 1), (288, 1, 1))](
            x_view, w["qkv"], hidden_view, packed,
            N=5120, RESIDUAL=0, num_warps=9,
        )

    def norm_rope():
        _norm_rope[lambda: ((1040, 1, 1), (128, 1, 1))](
